# Enforce LF line endings across all platforms and prevent CRLF conversion
* text=auto eol=lf

# Explicitly enforce LF line endings on model checkpoint and all JSON artifacts
artifacts/** text eol=lf
*.json text eol=lf

# Explicitly enforce LF line endings on Python source and test suites
src/** text eol=lf
tests/** text eol=lf
scripts/** text eol=lf
*.py text eol=lf

# Explicitly enforce LF line endings on documentation, research reports, manifests, and configs
research/** text eol=lf
outputs/** text eol=lf
docs/** text eol=lf
.agents/** text eol=lf
.github/** text eol=lf
*.md text eol=lf
*.csv text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
